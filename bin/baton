#!/usr/bin/env ruby
# frozen_string_literal: true

require "thor"
require_relative "../lib/baton"

module Baton
  class CLI < Thor
    desc "run PIECE", "Execute a piece workflow"
    option :task, type: :string, aliases: "-t", desc: "Task description to pass to the workflow"
    option :piece, type: :string, aliases: "-p", default: nil, desc: "Path to piece YAML file"
    option :plan, type: :string, aliases: "-f", default: nil, desc: "Path to plan file (skip plan step, start from implement)"
    option :dir, type: :string, aliases: "-d", default: ".", desc: "Working directory for agent execution"
    def run_piece(piece_name = "default")
      working_dir = File.expand_path(options[:dir])
      unless Dir.exist?(working_dir)
        puts "Error: Directory not found: #{working_dir}"
        exit 1
      end

      plan_content = nil

      if options[:plan]
        unless File.exist?(options[:plan])
          puts "Error: Plan file not found: #{options[:plan]}"
          exit 1
        end
        plan_content = File.read(options[:plan])
        piece_name = "from-plan" unless options[:piece]
      end

      piece_path = options[:piece] || find_piece(piece_name)
      unless piece_path && File.exist?(piece_path)
        puts "Error: Piece '#{piece_name}' not found at #{piece_path}"
        exit 1
      end

      config = Models::PieceLoader.load_file(piece_path)
      task = options[:task] || config.task || ""

      Baton.setup!

      logger = Engine::Logger.new
      engine = Engine::PieceEngine.new(config, task: task, plan: plan_content, working_dir: working_dir, logger: logger)
      engine.run
    end

    desc "list", "List available pieces"
    def list
      pieces_dir = File.join(Baton.root, "config", "pieces")
      unless Dir.exist?(pieces_dir)
        puts "No pieces directory found at #{pieces_dir}"
        return
      end

      Dir.glob(File.join(pieces_dir, "*.yaml")).each do |path|
        name = File.basename(path, ".yaml")
        puts "  #{name}"
      end
    end

    desc "providers", "List registered providers"
    def providers
      Baton.setup!
      puts "Registered providers:"
      Providers::Registry.keys.each { |k| puts "  #{k}" }
    end

    desc "version", "Show baton version"
    def version
      puts "baton #{VERSION}"
    end

    # Thor uses "run" internally, so we map the command name
    map "run" => :run_piece

    private

    def find_piece(name)
      File.join(Baton.root, "config", "pieces", "#{name}.yaml")
    end
  end
end

Baton::CLI.start(ARGV)
